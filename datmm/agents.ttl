## ---------------------------------------------------------
## NCCR DATMM — Agent and Contribution
## ---------------------------------------------------------
## The contributor for all NCCR datasets is the NCI
## Surveillance, Epidemiology, and End Results (SEER)
## Program. Datasets reference the contribution below via
## bf:contribution.
## ---------------------------------------------------------

@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .

## === Agent ===

<http://id.nlm.nih.gov/datmm/agent/seer> a foaf:Agent ;
    foaf:name "Surveillance, Epidemiology, and End Results (SEER) Program, National Cancer Institute" ;
    dct:identifier "https://seer.cancer.gov" .

## === Contribution ===

<http://id.nlm.nih.gov/datmm/contribution/seer> a bf:Contribution ;
    bf:agent <http://id.nlm.nih.gov/datmm/agent/seer> ;
    bf:role "contributor" .
