## ---------------------------------------------------------
## DATMM Dataset Record: Pharmacy Claims (PHARM)
## ---------------------------------------------------------

@prefix datmm:  <http://id.nlm.nih.gov/datmm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .
@prefix schema: <http://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:   <http://www.w3.org/ns/adms#> .

<http://id.nlm.nih.gov/datmm/dataset/nccr-pharm> a datmm:Dataset ;
    dct:title "NCCR Pharmacy Claims (PHARM)" ;
    dct:alternative "PHARM" ;
    dct:description "Information derived from outpatient pharmacy providers' claims for medications dispensed to patients with cancer. Includes patients with claims since 2000 from commercial plans, Medicaid, and commercial pharmacies. Contains 9- and 11-digit NDC codes, CanMED and RxNorm drug classification, dispense quantity and duration, and months from diagnosis to dispense. Primarily oral antineoplastics and infusion-based chemotherapies; hospital-based chemotherapy agents currently not included. Contains 12,611,171 records." ;
    dct:identifier "nccr-pharm" ;
    dct:issued "2026-06-21"^^xsd:date ;
    dct:language "en" ;
    dct:rights "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process." ;
    adms:status "published" ;
    foaf:homepage <https://nccrdataplatform.ccdi.cancer.gov/data-browser/PHARM> ;
    dct:isPartOf <http://id.nlm.nih.gov/datmm/repository/nccr-data-platform> ;
    bf:contribution
        <http://id.nlm.nih.gov/datmm/contribution/nci-publisher> ,
        <http://id.nlm.nih.gov/datmm/contribution/dccps-creator> ;
    schema:funding <http://id.nlm.nih.gov/datmm/grant/ccdi> ;
    dct:subject
        <http://id.nlm.nih.gov/datmm/concept/nccr-0001> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0002> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0004> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0011> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0013> ;
    dct:bibliographicCitation "Childhood Cancer Data Initiative (CCDI) National Childhood Cancer Registry (NCCR) Data Platform: An interactive data platform for NCCR cancer statistics [Internet]. National Cancer Institute; [updated: June 21, 2026; cited: June 26, 2026]. doi: 10.71925/byd9-3d93." ;
    dct:isReferencedBy <http://id.nlm.nih.gov/datmm/documentation/nccr-pharm-dictionary> .

<http://id.nlm.nih.gov/datmm/documentation/nccr-pharm-dictionary> a datmm:Documentation ;
    dct:title "PHARM Data Dictionary" ;
    dct:type "application/json" ;
    dct:identifier "pharm_metadata.json" ;
    dct:description "Variable-level data dictionary defining 17 fields for pharmacy dispensing data including NDC codes, CanMED/RxNorm drug classification, and temporal relationships to diagnosis." ;
    foaf:homepage <https://nccrdataplatform.ccdi.cancer.gov/data-browser/PHARM/2> ;
    dct:references <http://id.nlm.nih.gov/datmm/dataset/nccr-pharm> .
