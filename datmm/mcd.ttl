## ---------------------------------------------------------
## DATMM Dataset Record: Medical Claims Diagnosis (MCD)
## ---------------------------------------------------------

@prefix datmm:  <http://id.nlm.nih.gov/datmm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:   <http://www.w3.org/ns/adms#> .

<http://id.nlm.nih.gov/datmm/dataset/nccr-mcd> a datmm:Dataset ;
    dct:title "NCCR Medical Claims Diagnosis (MCD)" ;
    dct:alternative "MCD" ;
    dct:description "Patient diagnosis data extracted from medical claims collected by various insurers. Includes the ICD-9 or ICD-10 diagnosis code associated with each claim, sequence numbers for diagnosis codes occurring on multiple claims within the same month, and months elapsed between the index cancer diagnosis and the service date of the claim. Contains 54,148,739 records." ;
    dct:identifier "nccr-mcd" ;
    dct:issued "2026-06-21"^^xsd:date ;
    dct:language "en" ;
    dct:rights "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process." ;
    adms:status "published" ;
    foaf:homepage <https://nccrdataplatform.ccdi.cancer.gov/data-browser/MCD> ;
    dct:isPartOf <http://id.nlm.nih.gov/datmm/repository/nccr-data-platform> ;
    dct:relation <http://id.nlm.nih.gov/datmm/dataset/nccr-mce> , <http://id.nlm.nih.gov/datmm/dataset/nccr-mcp> ;
    bf:contribution <http://id.nlm.nih.gov/datmm/contribution/seer> ;
    dct:subject
        <http://id.nlm.nih.gov/datmm/concept/nccr-0001> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0002> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0007> ;
    dct:bibliographicCitation "Childhood Cancer Data Initiative (CCDI) National Childhood Cancer Registry (NCCR) Data Platform: An interactive data platform for NCCR cancer statistics [Internet]. National Cancer Institute; [updated: June 21, 2026; cited: June 26, 2026]. doi: 10.71925/byd9-3d93." .
