## DATMM Dataset Record: Area-Based Measures (ABM)
## ---------------------------------------------------------

@prefix datmm:  <http://id.nlm.nih.gov/datmm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:   <http://www.w3.org/ns/adms#> .

<http://id.nlm.nih.gov/datmm/dataset/nccr-abm> a datmm:Dataset ;
    dct:title "NCCR Area-Based Measures (ABM)" ;
    dct:alternative "ABM" ;
    dct:description "Non-clinical data variables derived from the US Census Department providing broader context of health-related factors. Variables use 2010 Census attributes and 2010 Census-defined boundaries for diagnosis years 2006 through 2017, and 2020 Census attributes and boundaries for diagnosis years 2018 through 2023. Includes Yost socioeconomic status quintiles, Rural-Urban Commuting Area codes, Urban Rural Indicator Codes, and persistent poverty indicators. Every cancer diagnosis has its own record, with variables calculated for the census tract associated with the address known at the time of that diagnosis. Values provided for cases with SEER diagnosis year 2006-2023. Contains 1,614,685 records for 1,483,916 patients, aligned to the tumour records in CTC." ;
    dct:identifier "nccr-abm" ;
    dct:issued "2026-06-21"^^xsd:date ;
    dct:language "en" ;
    dct:rights "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process." ;
    adms:status "published" ;
    foaf:homepage <https://nccrdataplatform.ccdi.cancer.gov/data-browser/ABM> ;
    dct:isPartOf <http://id.nlm.nih.gov/datmm/repository/nccr-data-platform> ;
    bf:contribution <http://id.nlm.nih.gov/datmm/contribution/seer> ;
    dct:subject
        <http://id.nlm.nih.gov/datmm/concept/nccr-0001> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0002> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0004> ;
    dct:bibliographicCitation "Childhood Cancer Data Initiative (CCDI) National Childhood Cancer Registry (NCCR) Data Platform: An interactive data platform for NCCR cancer statistics [Internet]. National Cancer Institute; [updated: June 21, 2026; cited: June 26, 2026]. doi: 10.71925/byd9-3d93." .
