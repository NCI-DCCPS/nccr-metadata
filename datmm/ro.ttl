## DATMM Dataset Record: Radiation Oncology (RO)
## ---------------------------------------------------------

@prefix datmm:  <http://id.nlm.nih.gov/datmm/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix bf:     <http://id.loc.gov/ontologies/bibframe/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix adms:   <http://www.w3.org/ns/adms#> .

<http://id.nlm.nih.gov/datmm/dataset/nccr-ro> a datmm:Dataset ;
    dct:title "NCCR Radiation Oncology (RO)" ;
    dct:alternative "RO" ;
    dct:description "This data source does not represent the entire population of people diagnosed with cancer in the original catchment area. The Radiation Oncology data source comprises data from NCI-supported Cancer Centers and the Pediatric Proton/Photon Consortium Registry Exit Disclaimer (PPCR). This data source offers expanded radiation treatment data associated with each patient's course of therapy and provides an enhanced longitudinal perspective regarding a patient's exposure to radiotherapy. It also consists of radiation anatomic site, radiation therapy type, radiation energy type, total and prescribed doses and fractions, months from index diagnosis to start and end of radiation therapy event, and other data elements abstracted from the clinical record. This data source includes radiation therapy records for patients with a SEER diagnosis year of 1995-2023, and for radiation therapy events that took place between 1995-2023." ;
    dct:identifier "nccr-ro" ;
    dct:issued "2026-09-11"^^xsd:date ;
    dct:language "en" ;
    dct:rights "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process." ;
    adms:status "published" ;
    foaf:homepage <https://nccrdataplatform.ccdi.cancer.gov/data-browser/RO> ;
    dct:isPartOf <http://id.nlm.nih.gov/datmm/repository/nccr-data-platform> ;
    bf:contribution <http://id.nlm.nih.gov/datmm/contribution/seer> ;
    dct:subject
        <http://id.nlm.nih.gov/datmm/concept/nccr-0001> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0002> ,
        <http://id.nlm.nih.gov/datmm/concept/nccr-0010> ;
    dct:bibliographicCitation "Childhood Cancer Data Initiative (CCDI) National Childhood Cancer Registry (NCCR) Data Platform: An interactive data platform for NCCR cancer statistics [Internet]. National Cancer Institute; [updated: October 22, 2026; cited: November 12, 2026]. doi: 10.71925/byd9-3d93." .
