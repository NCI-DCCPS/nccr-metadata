    nccr:semanticType "numeric" ;
    nccr:sourceColumn "monthsFromDxToChemo" ;
    nccr:sourceVocabulary nccr:vocab-SEER-Recode .

nccr-var:ctc-monthsfromdxtohormone a nccr:Variable ;
