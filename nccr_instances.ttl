nccr-ds:medical-claims a nccr:DataSourceGroup ;
    rdfs:label "Medical Claims" ;
    nccr:hasMember nccr-ds:mcd,
        nccr-ds:mce,
        nccr-ds:mcp ;
    nccr:sourceId "MEDICAL-CLAIMS" ;
    nccr:sourceLabel "Medical Claims" .

