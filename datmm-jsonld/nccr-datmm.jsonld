    {
      "@type": "datmm:Dataset",
      "dct:identifier": [
        "nccr-pharm"
      ],
      "dct:title": "NCCR Pharmacy Claims (PHARM)",
      "dct:alternative": [
        "PHARM"
      ],
      "foaf:homepage": "https://nccrdataplatform.ccdi.cancer.gov/data-browser/PHARM",
      "dct:description": "Information derived from outpatient pharmacy providers' claims for medications dispensed to patients with cancer. Includes patients with claims since 2000 from commercial plans, Medicaid, and commercial pharmacies. Contains 9- and 11-digit NDC codes, CanMED and RxNorm drug classification, dispense quantity and duration, and months from diagnosis to dispense. Primarily oral antineoplastics and infusion-based chemotherapies; hospital-based chemotherapy agents currently not included. Contains 12,611,171 records.",
      "dct:language": "en",
      "dct:rights": [
        "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process."
      ],
      "adms:status": "published",
      "dct:isPartOf": [
        {
          "@type": "datmm:Repository",
          "dct:identifier": null,
          "dct:title": "National Childhood Cancer Registry (NCCR) Data Platform",
          "foaf:homepage": "https://nccrdataplatform.ccdi.cancer.gov/home",
          "dct:alternative": [
            "NCCR Data Platform"
          ],
