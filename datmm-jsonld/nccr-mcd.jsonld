      "@type": "datmm:Dataset",
      "dct:identifier": [
        "nccr-mcd"
      ],
      "dct:title": "NCCR Medical Claims Diagnosis (MCD)",
      "dct:alternative": [
        "MCD"
      ],
      "foaf:homepage": "https://nccrdataplatform.ccdi.cancer.gov/data-browser/MCD",
      "dct:description": "This data source does not represent the entire population of people diagnosed with cancer in the original catchment area. The Medical Claims Diagnosis data source provides patient diagnosis data extracted from medical claims collected by various insurers. It includes the ICD-9 or ICD-10 diagnosis code associated with each claim, the sequence number for diagnosis codes that occurred on multiple claims within the same month, and the number of months that elapsed between the index cancer diagnosis and the service start date of the claim for the diagnosis code. This data source includes claims with an original service start date between 2000-2025.",
      "dct:issued": "2026-09-11",
      "dct:language": "en",
      "dct:rights": [
        "Controlled access. Individual-level de-identified data requires IRB review and approval via the NCCR Data Access Request process."
      ],
