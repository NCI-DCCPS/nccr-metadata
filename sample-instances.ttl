## ---------------------------------------------------------
## NCCR Sample Instance Data — for the interactive graph viewer
## ---------------------------------------------------------
## A small, curated slice of the full nccr_instances.ttl (~42k triples),
## chosen to be readable as a node-link graph. Shows the real shape of the
## data: a DataSource -> its Variables -> each Variable's ValueSet -> the
## CodeValues (permissible values) with real record counts.
##
## This is REAL data from the Area-Based Measures (ABM) datasource.
## The full instance graph lives in nccr_instances.ttl (the source of truth);
## this file is a display-sized sample for graph/erd.html visualization.
## ---------------------------------------------------------

@prefix nccr:    <https://nccrdataplatform.ccdi.cancer.gov/vocab#> .
@prefix nccr-ds: <https://nccrdataplatform.ccdi.cancer.gov/datasource/> .
@prefix nccr-var:<https://nccrdataplatform.ccdi.cancer.gov/variable/> .
@prefix nccr-vs: <https://nccrdataplatform.ccdi.cancer.gov/valueset/> .
@prefix nccr-cv: <https://nccrdataplatform.ccdi.cancer.gov/code/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

## ---- Data source ----
nccr-ds:abm a nccr:DataSource ;
    rdfs:label "Area-Based Measures (ABM)" ;
    nccr:sourceId "ABM" ;
    nccr:hasVariable nccr-var:abm-persistentpoverty ,
                     nccr-var:abm-ruca2010c ,
                     nccr-var:abm-uric2010a .

## ---- Variables ----
nccr-var:abm-persistentpoverty a nccr:Variable ;
    rdfs:label "Persistent Poverty" ;
    nccr:belongsToSource nccr-ds:abm ;
    nccr:sourceColumn "persistentPoverty" ;
    nccr:hasValueSet nccr-vs:abm-persistentpoverty .

nccr-var:abm-ruca2010c a nccr:Variable ;
    rdfs:label "2010 RUCA-based Categorization" ;
    nccr:belongsToSource nccr-ds:abm ;
    nccr:sourceColumn "ruca2010C" ;
    nccr:hasValueSet nccr-vs:abm-ruca2010c .

nccr-var:abm-uric2010a a nccr:Variable ;
    rdfs:label "Urban Rural Indicator Code (URIC)" ;
    nccr:belongsToSource nccr-ds:abm ;
    nccr:sourceColumn "uric2010A" ;
    nccr:hasValueSet nccr-vs:abm-uric2010a .

## ---- Value sets ----
nccr-vs:abm-persistentpoverty a nccr:ValueSet ;
    rdfs:label "Persistent Poverty — values" .
nccr-vs:abm-ruca2010c a nccr:ValueSet ;
    rdfs:label "RUCA — values" .
nccr-vs:abm-uric2010a a nccr:ValueSet ;
    rdfs:label "URIC — values" .

## ---- Code values (permissible values) with real record counts ----
nccr-cv:abm-persistentpoverty-0 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-persistentpoverty ;
    skos:prefLabel "No" ;
    nccr:codeNotation "0" ;
    nccr:recordCount 893260 .

nccr-cv:abm-persistentpoverty-1 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-persistentpoverty ;
    skos:prefLabel "Yes" ;
    nccr:codeNotation "1" ;
    nccr:recordCount 100113 .

nccr-cv:abm-persistentpoverty-7 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-persistentpoverty ;
    skos:prefLabel "No Data for Year of Diagnosis" ;
    nccr:codeNotation "7" ;
    nccr:recordCount 475642 .

nccr-cv:abm-persistentpoverty-9 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-persistentpoverty ;
    skos:prefLabel "Missing" ;
    nccr:codeNotation "9" ;
    nccr:recordCount 5353 .

nccr-cv:abm-ruca2010c-1 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-ruca2010c ;
    skos:prefLabel "Urban" ;
    nccr:codeNotation "1" .

nccr-cv:abm-ruca2010c-2 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-ruca2010c ;
    skos:prefLabel "Rural" ;
    nccr:codeNotation "2" .

nccr-cv:abm-uric2010a-1 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-uric2010a ;
    skos:prefLabel "All urban" ;
    nccr:codeNotation "1" .

nccr-cv:abm-uric2010a-2 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-uric2010a ;
    skos:prefLabel "Mostly urban" ;
    nccr:codeNotation "2" .

nccr-cv:abm-uric2010a-3 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-uric2010a ;
    skos:prefLabel "Mostly rural" ;
    nccr:codeNotation "3" .

nccr-cv:abm-uric2010a-4 a nccr:CodeValue ;
    skos:inScheme nccr-vs:abm-uric2010a ;
    skos:prefLabel "All rural" ;
    nccr:codeNotation "4" .
